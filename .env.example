# Copy this template to .env for local development. Never commit .env.
# Real requests/results and MQTT Discovery on the configured broker.
# Optional read-only broker in Settings; bind it explicitly in MQTT Input.
# With an empty host, configure brokers through Settings instead.

# MQTT broker reachable from Docker (usually the HA host if it runs Mosquitto).
# Enter a hostname/IP only, without http:// or a port.
DEV_MQTT_HOST=
DEV_MQTT_PORT=1883
DEV_MQTT_TLS=false
# Use single quotes around values, especially passwords containing $ or #.
DEV_MQTT_USERNAME=''
DEV_MQTT_PASSWORD=''

# An HA long-lived API token is NOT an MQTT password.
# HA AI Studio needs no HA URL or HA API token for MQTT.
# Apply changes with: docker compose up -d --build
